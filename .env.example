# GEMINI_API_KEY: Required for server-side Gemini AI & Google Search Grounding calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Default invite code seeded on first start and daily detection quota
DEFAULT_INVITE_CODE="dev-local-001"
DEFAULT_DAILY_LIMIT="50"

# Path to local SQLite database file (avoid quoted Windows paths on Linux/container environments)
DATABASE_PATH="./data/gacha-db.db"

# --- V2.0 Multi-Source Market Price Lookup Configuration ---
# Enable Channel A (Search Grounding / Search API) by default ("true" | "false")
PRICE_LOOKUP_SEARCH_ENABLED="true"

# Optional external search API provider for Channel A when not using Gemini Search Grounding:
# Supported values: "gemini_grounding" | "tavily" | "serper" | "bocha"
SEARCH_API_PROVIDER="gemini_grounding"
SEARCH_API_KEY=""

# Optional Channel B proxy/third-party compliant adapters (must be public https:// URLs)
MERCARI_PROXY_URL=""
MERCARI_PROXY_TOKEN=""
XIANYU_PROXY_URL=""
XIANYU_PROXY_TOKEN=""

# JPY -> CNY conversion rate and international shipping multiplier (e.g. 0.12 = +12%)
DEFAULT_JPY_RATE="0.048"
INTL_SHIPPING_FACTOR="0.12"

# Market price lookup cache TTL in hours (default 48h)
PRICE_CACHE_TTL_HOURS="48"
